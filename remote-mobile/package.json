{
  "name": "agmux-remote-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Native iOS shell for agmux Remote (Capacitor + existing PWA)",
  "scripts": {
    "sync-web": "node scripts/sync-web.mjs",
    "build": "npm run sync-web",
    "cap:sync": "npm run sync-web && npx cap sync ios",
    "cap:open": "npx cap open ios",
    "ios": "npm run cap:sync && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2"
  }
}
