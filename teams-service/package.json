{
  "name": "agmux-teams-service",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --var DEV_AUTH:true --var APP_ORIGIN:http://localhost:8787",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute agmux-teams --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute agmux-teams --remote --file=./schema.sql",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "@types/node": "^24.0.0",
    "jsdom": "^29.0.2",
    "typescript": "^5.8.3",
    "vitest": "^4.1.3",
    "wrangler": "^4.24.0"
  }
}
