{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "agmux",
  "version": "4.3.0",
  "identifier": "com.xanom.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "",
        "width": 1400,
        "height": 990,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "acceptFirstMouse": true,
        "transparent": true,
        "dragDropEnabled": true,
        "theme": "Dark",
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: blob: https://avatars.githubusercontent.com https://*.googleusercontent.com; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost data: https://api.anthropic.com https://openrouter.ai http://localhost:11434 https://api.github.com https://agmux.dev; worker-src 'self' blob:",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/AppIcon.icon": "AppIcon.icon",
      "sounds/xanom-notify.wav": "xanom-notify.wav",
      "../sidecar/dist/claude-sdk-bridge.bundle.mjs": "sidecar/dist/claude-sdk-bridge.bundle.mjs",
      "../sidecar/dist/opencode-sdk-bridge.bundle.mjs": "sidecar/dist/opencode-sdk-bridge.bundle.mjs",
      "../sidecar/dist/opencode-sdk-bridge.bundle.cjs": "sidecar/dist/opencode-sdk-bridge.bundle.cjs",
      "../sidecar/dist/cursor-sdk-bridge.bundle.mjs": "sidecar/dist/cursor-sdk-bridge.bundle.mjs",
      "../sidecar/dist/cursor-sdk-runtime": "sidecar/dist/cursor-sdk-runtime",
      "../sidecar/dist/agmux-memory-mcp.bundle.mjs": "sidecar/dist/agmux-memory-mcp.bundle.mjs",
      "../sidecar/dist/agmux-memory-cli.bundle.mjs": "sidecar/dist/agmux-memory-cli.bundle.mjs"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "./Info.plist",
      "signingIdentity": "Xanom Dev Signing",
      "entitlements": "./entitlements.plist",
      "dmg": {
        "background": "./dmg-background.png",
        "windowSize": {
          "width": 680,
          "height": 400
        },
        "appPosition": {
          "x": 195,
          "y": 185
        },
        "applicationFolderPosition": {
          "x": 485,
          "y": 185
        }
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkyODIzNUJGNDNBQkQ4QkQKUldTOTJLdER2eldDa25FeURBWHB4YzJURU5WWnBHcE1heFYxM2ZzYnBZTW1tNTFLTEl2SzFJeTcK",
      "endpoints": [
        "https://agmux.dev/api/updates/latest.json",
        "https://github.com/neelsatyavolu/agmux/releases/latest/download/latest.json"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": ["agmux"]
      }
    }
  }
}
